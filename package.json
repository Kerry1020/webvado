{
  "name": "webvado",
  "version": "0.1.0",
  "description": "Open-source web-based FPGA development environment inspired by Xilinx Vivado",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon --watch backend backend/server.js",
    "dev:frontend": "cd frontend && python3 -m http.server 8080",
    "start": "node backend/server.js",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "esbuild frontend/js/main.js --bundle --outfile=dist/frontend/js/bundle.js --minify",
    "build:backend": "esbuild backend/server.js --bundle --outfile=dist/backend/server.js --platform=node --minify",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint backend frontend/js",
    "format": "prettier --write \"**/*.{js,json,md,css,html}\"",
    "check-tools": "node scripts/check-toolchain.js"
  },
  "keywords": [
    "fpga",
    "verilog",
    "systemverilog",
    "synthesis",
    "simulation",
    "eda",
    "vivado",
    "open-source",
    "ice40",
    "ecp5",
    "yosys",
    "nextpnr"
  ],
  "author": "WebVado Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/webvado.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/webvado/issues"
  },
  "homepage": "https://github.com/yourusername/webvado#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-ws": "^5.0.2",
    "fs-extra": "^11.1.1",
    "execa": "^8.0.1",
    "pino": "^8.16.0",
    "pino-pretty": "^10.2.3",
    "chokidar": "^3.5.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1",
    "joi": "^17.11.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.19.5",
    "eslint": "^8.53.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0",
    "playwright": "^1.40.0"
  }
}
