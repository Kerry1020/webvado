{
  "name": "webvado",
  "version": "0.1.0",
  "description": "Open-source web-based FPGA development environment inspired by Xilinx Vivado",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:backend": "nodemon --watch backend backend/server.js",
    "dev:frontend": "npm run dev:backend",
    "start": "node backend/server.js",
    "build": "node scripts/build.js",
    "build:frontend": "node scripts/build.js frontend",
    "build:backend": "node scripts/build.js backend",
    "check": "node scripts/check-syntax.js",
    "test": "node --test tests/unit/*.test.js tests/hardware/*.test.js",
    "test:watch": "node --test --watch tests/unit/*.test.js tests/hardware/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/unit/*.test.js tests/hardware/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "node scripts/test-server.js",
    "lint": "eslint backend frontend/js",
    "format": "prettier --write \"**/*.{js,json,md,css,html}\"",
    "check-tools": "node scripts/check-toolchain.js"
  },
  "keywords": [
    "fpga",
    "verilog",
    "systemverilog",
    "synthesis",
    "simulation",
    "eda",
    "vivado",
    "open-source",
    "ice40",
    "ecp5",
    "yosys",
    "nextpnr"
  ],
  "author": "WebVado Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kerry1020/webvado.git"
  },
  "bugs": {
    "url": "https://github.com/Kerry1020/webvado/issues"
  },
  "homepage": "https://github.com/Kerry1020/webvado#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-ws": "^5.0.2",
    "fs-extra": "^11.1.1",
    "execa": "^8.0.1",
    "pino": "^8.16.0",
    "pino-pretty": "^10.2.3",
    "chokidar": "^3.5.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1",
    "joi": "^17.11.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.19.5",
    "eslint": "^8.53.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0",
    "playwright": "^1.40.0"
  }
}
